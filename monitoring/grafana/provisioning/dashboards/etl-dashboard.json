  "templating": {
    "list": [
      {
        "name": "source",
        "label": "Source",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values({__name__=~\"ingestor_source_info|extractor_run_info|transformer_run_info\"}, source)",
          "refId": "sources"
        },
        "definition": "label_values({__name__=~\"ingestor_source_info|extractor_run_info|transformer_run_info\"}, source)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
